<Window x:Class="CodexRemaining.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 剩余用量"
        MinWidth="104"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem Header="立即刷新" Click="RefreshMenuItem_Click" />
            <MenuItem Header="自动刷新间隔">
                <MenuItem x:Name="OneMinuteRefreshMenuItem"
                          Header="1 分钟"
                          IsCheckable="True"
                          Click="RefreshIntervalMenuItem_Click" />
                <MenuItem x:Name="FiveMinuteRefreshMenuItem"
                          Header="5 分钟"
                          IsCheckable="True"
                          Click="RefreshIntervalMenuItem_Click" />
                <MenuItem x:Name="TenMinuteRefreshMenuItem"
                          Header="10 分钟"
                          IsCheckable="True"
                          Click="RefreshIntervalMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="AutoStartMenuItem"
                      Header="开机自启"
                      IsCheckable="True"
                      Click="AutoStartMenuItem_Click" />
            <MenuItem Header="胶囊尺寸">
                <MenuItem x:Name="SmallSizeMenuItem"
                          Header="小"
                          IsCheckable="True"
                          Click="CapsuleSizeMenuItem_Click" />
                <MenuItem x:Name="MediumSizeMenuItem"
                          Header="中"
                          IsCheckable="True"
                          Click="CapsuleSizeMenuItem_Click" />
                <MenuItem x:Name="LargeSizeMenuItem"
                          Header="大"
                          IsCheckable="True"
                          Click="CapsuleSizeMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="重置悬浮位置" Click="ResetPositionMenuItem_Click" />
            <Separator />
            <MenuItem Header="退出" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="OptionalStatus" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" MinWidth="104" Background="{DynamicResource CardBackground}"
            UseLayoutRounding="True" SnapsToDevicePixels="True"
            TextElement.FontFamily="Segoe UI"
            TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="BorderBrush" Value="{Binding Display.VisualState, Converter={StaticResource UsageVisualStateToBrushConverter}}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="CornerRadius" Value="16" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Display.ResetExactText}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{Binding Display.VisualState, Converter={StaticResource UsageVisualStateToBrushConverter}}" />
                <TextBlock Text="{Binding Display.CompactText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text=" ↻" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Width="320">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Codex 剩余用量" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,8,0" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="↻ 立即刷新" Style="{StaticResource RefreshButton}" HorizontalAlignment="Right"
                                Margin="0,-3,-4,0" AutomationProperties.Name="立即刷新" Click="RefreshMenuItem_Click" />
                        <TextBlock Text="{Binding Display.UpdatedText}" Style="{StaticResource SecondaryText}"
                                   FontSize="11.5" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Display.RemainingText}" FontSize="25" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Display.ResetText}" ToolTip="{Binding Display.ResetExactText}"
                               FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </Grid>
                <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100"
                             Value="{Binding Display.RemainingPercent, Mode=OneWay}"
                             Visibility="{Binding Display.HasWeeklyUsage, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Background="{DynamicResource ProgressTrackBrush}"
                             Foreground="{Binding Display.VisualState, Converter={StaticResource UsageVisualStateToBrushConverter}}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="3" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock Text="{Binding Display.StatusText}" Style="{StaticResource OptionalStatus}" />

                <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Display.ResetCreditsText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Display.ResetCreditExpiryText}" ToolTip="{Binding Display.ResetCreditExpiryExactText}"
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding Display.ResetCreditsStatusText}" Style="{StaticResource OptionalStatus}" />

                <Border Height="1" Margin="0,10,0,10" Background="{DynamicResource DividerBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="本机今日 Token" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding Display.LocalTodayText}" ToolTip="{Binding Display.LocalTodayExactText}"
                                   FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Display.LocalStatusText}" Style="{StaticResource OptionalStatus}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" Margin="0,1,0,0" />
                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock Text="账号近 7 日 Token" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding Display.AccountSevenDayText}" ToolTip="{Binding Display.AccountSevenDayExactText}"
                                   FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Display.AccountThroughText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Display.AccountStatusText}" Style="{StaticResource OptionalStatus}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Display.DetailText}" Style="{StaticResource OptionalStatus}" Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
