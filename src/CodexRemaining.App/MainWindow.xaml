<Window x:Class="CodexRemaining.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 剩余用量"
        MinWidth="104"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem Header="立即刷新" Click="RefreshMenuItem_Click" />
            <MenuItem x:Name="AutoStartMenuItem"
                      Header="开机自启"
                      IsCheckable="True"
                      Click="AutoStartMenuItem_Click" />
            <MenuItem Header="重置悬浮位置" Click="ResetPositionMenuItem_Click" />
            <Separator />
            <MenuItem Header="退出" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Padding="14,8"
            CornerRadius="18"
            Background="{DynamicResource CardBackground}"
            BorderThickness="1.5"
            BorderBrush="{Binding Display.VisualState, Converter={StaticResource UsageVisualStateToBrushConverter}}"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" />
        </Border.Effect>

        <StackPanel>
            <DockPanel LastChildFill="True">
                <Ellipse Width="8"
                         Height="8"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{Binding Display.VisualState, Converter={StaticResource UsageVisualStateToBrushConverter}}" />
                <TextBlock Text="{Binding Display.CompactText}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text=" ↻"
                           Margin="6,0,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>

            <StackPanel Margin="0,8,0,2"
                        MinWidth="180"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Display.StatusText}"
                           Margin="0,0,0,3"
                           FontWeight="SemiBold"
                           Foreground="{Binding Display.VisualState, Converter={StaticResource UsageVisualStateToBrushConverter}}" />
                <TextBlock Text="{Binding Display.ResetText}"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding Display.UpdatedText}"
                           Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding Display.DetailText}"
                           Margin="0,4,0,0"
                           MaxWidth="260"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <Button Content="立即刷新"
                        Margin="-4,5,0,-3"
                        Padding="4,2"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Click="RefreshMenuItem_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
