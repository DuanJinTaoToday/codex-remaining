<Window x:Class="CodexRemaining.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 剩余用量"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Window.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem Header="立即刷新" Click="RefreshMenuItem_Click" />
            <MenuItem Header="自动刷新间隔">
                <MenuItem x:Name="OneMinuteRefreshMenuItem"
                          Header="1 分钟"
                          IsCheckable="True"
                          Click="RefreshIntervalMenuItem_Click" />
                <MenuItem x:Name="FiveMinuteRefreshMenuItem"
                          Header="5 分钟"
                          IsCheckable="True"
                          Click="RefreshIntervalMenuItem_Click" />
                <MenuItem x:Name="TenMinuteRefreshMenuItem"
                          Header="10 分钟"
                          IsCheckable="True"
                          Click="RefreshIntervalMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="AutoStartMenuItem"
                      Header="开机自启"
                      IsCheckable="True"
                      Click="AutoStartMenuItem_Click" />
            <MenuItem Header="胶囊尺寸">
                <MenuItem x:Name="SmallSizeMenuItem"
                          Header="小"
                          IsCheckable="True"
                          Click="CapsuleSizeMenuItem_Click" />
                <MenuItem x:Name="MediumSizeMenuItem"
                          Header="中"
                          IsCheckable="True"
                          Click="CapsuleSizeMenuItem_Click" />
                <MenuItem x:Name="LargeSizeMenuItem"
                          Header="大"
                          IsCheckable="True"
                          Click="CapsuleSizeMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="重置悬浮位置" Click="ResetPositionMenuItem_Click" />
            <Separator />
            <MenuItem Header="退出" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="OptionalStatus" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RemainingValue" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Display.RemainingPercent, StringFormat={}{0}%}" />
            <Setter Property="FontSize" Value="{DynamicResource CompactValueFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Display.HasWeeklyUsage}" Value="False">
                    <Setter Property="Text" Value="--" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TokenValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="{DynamicResource TokenFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="Content" Value="↻ 立即刷新" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                    <Setter Property="Content" Value="正在刷新" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderThickness="1"
            TextElement.FontFamily="Segoe UI, Microsoft YaHei UI"
            TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Width" Value="{DynamicResource CompactWidth}" />
                <Setter Property="Background" Value="{DynamicResource CompactBackground}" />
                <Setter Property="BorderBrush" Value="{Binding Display.VisualState, Converter={StaticResource UsageVisualStateToBrushConverter}, ConverterParameter=Outline}" />
                <Setter Property="Padding" Value="{DynamicResource CompactPadding}" />
                <Setter Property="CornerRadius" Value="20" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter Property="Width" Value="{DynamicResource ExpandedWidth}" />
                        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
                        <Setter Property="Padding" Value="{DynamicResource ExpandedPadding}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                        <Setter Property="CornerRadius" Value="15" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        ToolTip="{Binding Display.ResetExactText}"
                        AutomationProperties.Name="{Binding Display.CompactText}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                         Fill="{Binding Display.VisualState, Converter={StaticResource UsageVisualStateToBrushConverter}, ConverterParameter=Dot}" />
                <TextBlock Text="周" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource RemainingValue}" Margin="5,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="↻" Margin="5,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Codex 剩余用量" FontSize="{DynamicResource HeaderFontSize}"
                               FontWeight="SemiBold" Margin="0,3,10,0" />
                    <StackPanel Grid.Column="1">
                        <Button Style="{StaticResource RefreshButton}" HorizontalAlignment="Right"
                                AutomationProperties.Name="立即刷新" Click="RefreshMenuItem_Click" />
                        <TextBlock Text="{Binding Display.UpdatedText}" Style="{StaticResource OptionalStatus}"
                                   Margin="0,0,0,0" TextAlignment="Right" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="{DynamicResource SectionMargin}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource RemainingValue}" FontSize="{DynamicResource HeroFontSize}" />
                            <TextBlock Text="剩余" Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Bottom" Margin="5,0,0,3" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Display.ResetText}"
                                   ToolTip="{Binding Display.ResetExactText}" Style="{StaticResource SecondaryText}"
                                   TextAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <ProgressBar Height="5" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding Display.RemainingPercent, Mode=OneWay}"
                                 Visibility="{Binding Display.HasWeeklyUsage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Background="{DynamicResource ProgressTrackBrush}"
                                 Foreground="{Binding Display.VisualState, Converter={StaticResource UsageVisualStateToBrushConverter}}">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid x:Name="PART_Track">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}" CornerRadius="3" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock Text="{Binding Display.StatusText}" Style="{StaticResource OptionalStatus}" />
                </StackPanel>

                <Grid Margin="{DynamicResource SectionMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Display.ResetCreditsText}" Style="{StaticResource SecondaryText}"
                               FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Display.ResetCreditExpiryText}" ToolTip="{Binding Display.ResetCreditExpiryExactText}"
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding Display.ResetCreditsStatusText}" Style="{StaticResource OptionalStatus}" />

                <Border Margin="{DynamicResource SectionMargin}" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource CardBorderBrush}" Padding="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="本机今日 Token" Style="{StaticResource SecondaryText}" />
                            <TextBlock Text="{Binding Display.LocalTodayText}" ToolTip="{Binding Display.LocalTodayExactText}"
                                       Style="{StaticResource TokenValue}" />
                            <TextBlock Text="{Binding Display.LocalStatusText}" Style="{StaticResource OptionalStatus}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource CardBorderBrush}" />
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="账号近 7 日 Token" Style="{StaticResource SecondaryText}" />
                            <TextBlock Text="{Binding Display.AccountSevenDayText}" ToolTip="{Binding Display.AccountSevenDayExactText}"
                                       Style="{StaticResource TokenValue}" />
                            <TextBlock Text="{Binding Display.AccountThroughText}" Style="{StaticResource OptionalStatus}" />
                            <TextBlock Text="{Binding Display.AccountStatusText}" Style="{StaticResource OptionalStatus}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Display.DetailText}" Style="{StaticResource OptionalStatus}"
                           Margin="{DynamicResource SectionMargin}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
