<Application x:Class="CodexRemaining.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodexRemaining.App">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:UsageVisualStateToBrushConverter x:Key="UsageVisualStateToBrushConverter" />
        <SolidColorBrush x:Key="CardBackground" Color="#F7FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF4B5563" />
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FFE5E7EB" />
        <SolidColorBrush x:Key="DividerBrush" Color="#FFD1D5DB" />
    </Application.Resources>
</Application>
