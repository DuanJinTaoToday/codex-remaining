<Application x:Class="CodexRemaining.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodexRemaining.App">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:UsageVisualStateToBrushConverter x:Key="UsageVisualStateToBrushConverter" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFCFCFD" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF20252E" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF4B5563" />
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FFE5E9ED" />
        <SolidColorBrush x:Key="DividerBrush" Color="#FFE5E9ED" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FFD9DEE5" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF0F3F5" />
        <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#FFFFF0D4" />
    </Application.Resources>
</Application>
